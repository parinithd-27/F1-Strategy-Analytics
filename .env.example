# Copy to .env and adjust. Never commit .env. No real values belong in this file.
# Storage root for the data lake: file://<path> or hdfs://<namenode>:<port>/<path>
DATA_LAKE_URI=file://./data/lake
# Host-side endpoints. If you change KAFKA_HOST_PORT / REDIS_HOST_PORT below, change these too.
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC_EVENTS=f1.race.events
REDIS_URL=redis://localhost:6379/0
# Seconds race keys live after session_end
REDIS_TTL_AFTER_SESSION_S=3600
# Safety TTL (seconds) refreshed on every race-key write, in case session_end never arrives
REDIS_SAFETY_TTL_S=21600
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
# Self-imposed budget; Jolpica's hard limit is 500/h (and 4 req/s)
JOLPICA_MAX_PER_HOUR=450
JOLPICA_CACHE_DIR=data/cache/jolpica
# Sent on every Jolpica request; names the project only (no personal details)
JOLPICA_USER_AGENT=F1-Strategy-Analytics/0.1.0 (IISc academic project; python-requests)
FASTF1_CACHE_DIR=data/cache/fastf1
# FastF1 pacing (races per hour) so its own Jolpica/livetiming calls stay under FastF1's hard limits
FASTF1_MAX_RACES_PER_HOUR=20
# Ingestion state (must be under data/)
MANIFEST_PATH=data/manifest.json
# HDFS sink: set DATA_LAKE_URI=hdfs://namenode:8020/f1 and use --sink hdfs. Bytes go through HttpFS.
HDFS_HTTPFS_URL=http://localhost:14000
HDFS_USER=hadoop
# Block replication for files we write (Spark jobs and HttpFS); the dev cluster has one datanode
HDFS_REPLICATION=1
# TracingInsights loader (Step 4C): tree cache and manifest (both under data/), disk guard
TRACINGINSIGHTS_CACHE_DIR=data/cache/tracinginsights
TRACINGINSIGHTS_MANIFEST_PATH=data/manifest_tracinginsights.json
# Free space is checked on the Windows drive backing WSL (the WSL filesystem reports its virtual size)
TI_DISK_GUARD_PATH=/mnt/c
TI_MIN_FREE_GB=20
# F1 TV Access login for FastF1 (set both or neither)
F1_USERNAME=
F1_PASSWORD=

# --- Docker Compose (read by `docker compose` for interpolation) ---
# Published host ports (3000 web and 8000 api are reserved for later steps)
KAFKA_HOST_PORT=9092
REDIS_HOST_PORT=6379
HDFS_NAMENODE_UI_PORT=9870
HDFS_HTTPFS_PORT=14000
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER1_UI_PORT=8081
SPARK_WORKER2_UI_PORT=8082
# Spark standalone workers (x2): executor memory/cores each, and the container limit
SPARK_WORKER_MEMORY=1g
SPARK_WORKER_CORES=2
SPARK_WORKER_CONTAINER_MEM=1536m
# Data lake root as seen inside the app container (repo is mounted at /workspace)
APP_DATA_LAKE_URI=file:///workspace/data/lake
# UID for the container user (match `id -u` so bind-mounted files stay yours)
APP_UID=1000

# API (Step 13). Bind address of `make api` (the compose service binds 0.0.0.0 inside its
# container and publishes 127.0.0.1:${API_HOST_PORT} only). CORS allows the listed origins.
API_HOST=127.0.0.1
API_PORT=8000
API_HOST_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 1 enables POST /api/races/{s}/{r}/replay / POST /api/debug/latency; 1 also lists/replays 2025.
ENABLE_REPLAY=0
ENABLE_DEBUG=0
ALLOW_TEST_SEASON=0
API_MAX_REPLAYS=1
API_SSE_HEARTBEAT_S=15
API_RACES_CACHE_S=300
API_KAFKA_TIMEOUT_S=2
API_MODEL_DIR=models/undercut/deploy_real_G3.5_k2
# What-if tyre models (make sim-tyre-model-sample / sim-tyre-model-full)
API_SIM_DIR=models/sim
API_UI_LATENCY_CSV=results/ui_latency.csv


# Dashboard (Step 14). NEXT_PUBLIC_* are inlined into the browser bundle at build time.
WEB_HOST_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEBUG_LATENCY=0
