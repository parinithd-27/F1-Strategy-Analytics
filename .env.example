# Copy to .env and adjust. Never commit .env. No real values belong in this file.
# Storage root for the data lake: file://<path> or hdfs://<namenode>:<port>/<path>
DATA_LAKE_URI=file://./data/lake
# Host-side endpoints. If you change KAFKA_HOST_PORT / REDIS_HOST_PORT below, change these too.
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC_EVENTS=f1.race.events
REDIS_URL=redis://localhost:6379/0
# Seconds race keys live after session_end
REDIS_TTL_AFTER_SESSION_S=3600
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
# Self-imposed budget; Jolpica's hard limit is 500/h (and 4 req/s)
JOLPICA_MAX_PER_HOUR=450
JOLPICA_CACHE_DIR=data/cache/jolpica
# Sent on every Jolpica request; names the project only (no personal details)
JOLPICA_USER_AGENT=F1-Strategy-Analytics/0.1.0 (IISc academic project; python-requests)
FASTF1_CACHE_DIR=data/cache/fastf1
# F1 TV Access login for FastF1 (set both or neither)
F1_USERNAME=
F1_PASSWORD=

# --- Docker Compose (read by `docker compose` for interpolation) ---
# Published host ports (3000 web and 8000 api are reserved for later steps)
KAFKA_HOST_PORT=9092
REDIS_HOST_PORT=6379
HDFS_NAMENODE_UI_PORT=9870
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER1_UI_PORT=8081
SPARK_WORKER2_UI_PORT=8082
# Spark standalone workers (x2): executor memory/cores each, and the container limit
SPARK_WORKER_MEMORY=1g
SPARK_WORKER_CORES=2
SPARK_WORKER_CONTAINER_MEM=1536m
# Data lake root as seen inside the app container (repo is mounted at /workspace)
APP_DATA_LAKE_URI=file:///workspace/data/lake
# UID for the container user (match `id -u` so bind-mounted files stay yours)
APP_UID=1000
